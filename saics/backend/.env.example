PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=saics_db

# SMTP settings are required to email verification codes outside development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Bootstrap the first administrator with `npm run seed:admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Configure at least one cloud provider; the backend tries Groq, then Gemini,
# then the local Ollama server.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
